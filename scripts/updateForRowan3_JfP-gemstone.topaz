	iferr 1 stk
	iferr 2 stack
	iferr 3 exit

	expectvalue true
	run
| warnings rowanProjectsHome |
warnings := String new.
rowanProjectsHome := '$ROWAN_PROJECTS_HOME'.
[

true ifTrue: [ 
	"temporary patch to ensure feenkcom fork is used"
	| spec |
	spec := RwSpecification fromUrl: 'https://raw.githubusercontent.com/feenkcom/RemoteServiceReplication/martin-136PortRange/rowan/specs/RemoteServiceReplication.ston'.
	spec 
		revision: 'martin-136PortRange';
		projectsHome: rowanProjectsHome;
		load
]

] on: CompileWarning do: [:ex |
	(ex description includesString: 'not optimized')
			ifFalse: [ warnings 
                           addAll: ex asString;
                           lf ].
	ex resume ].
warnings isEmpty
	ifTrue: [ true ]
	ifFalse: [ warnings ]
%
	commit

	errorCount
